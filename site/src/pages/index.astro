---
import BaseLayout from "../layouts/BaseLayout.astro";
import { catalogue, prestations } from "../lib/catalogue";
import { withBase } from "../lib/paths";

const identity = catalogue.identite as Record<string, string>;
const navigationCards = [
  {
    title: "Parcours & CV",
    description: "Expériences, formations et compétences au fil du parcours.",
    label: "Explorer le parcours",
    href: "/experiences/",
    image: "/visuals/formation-institut-agro-rennes.jpg",
    alt: "Bâtiment de l’Institut Agro Rennes-Angers"
  },
  {
    title: "Projets académiques",
    description: "Modélisation, apprentissage automatique et données du vivant.",
    label: "Voir les projets",
    href: "/projets/",
    image: "/visuals/project-protein-structure.webp",
    alt: "Visualisation de la structure d’une protéine"
  },
  {
    title: "Conseil & prestations indépendantes",
    description: "Data science, statistiques et accompagnement méthodologique.",
    label: "Découvrir les prestations",
    href: "/prestations/",
    image: "/visuals/portrait-moise.jpg",
    alt: "Portrait de Moïse Placier"
  }
];
---

<BaseLayout description={identity.presentation}>
  <section class="hero shell">
    <div class="eyebrow">{prestations.positionnement}</div>
    <div class="hero-grid hero-grid--single">
      <div>
        <h1>Moïse<br /><em>Placier</em></h1>
        <p class="hero-title">{prestations.titre_accueil}</p>
        <p class="hero-availability">{prestations.disponibilite}</p>
        <div class="hero-actions">
          <a class="button button-dark" href={withBase("/prestations/#contact")}>{prestations.appel_action.libelle} <span>→</span></a>
          <a class="text-link" href={withBase("/experiences/")}>Explorer le parcours <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="shell section services-preview">
    <div class="section-heading">
      <div>
        <span class="eyebrow">{prestations.page.surtitre}</span>
        <h2>{prestations.page.titre}</h2>
      </div>
      <a class="text-link" href={withBase("/prestations/")}>Voir les prestations <span>→</span></a>
    </div>
    <div class="service-strip">
      {prestations.page.expertises.map((expertise, index) => (
        <article>
          <span>0{index + 1}</span>
          <h3>{expertise.titre}</h3>
          <p>{expertise.resume}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section home-navigation">
    <div class="project-grid">
      {navigationCards.map((card, index) => (
        <a class="project-card" href={withBase(card.href)}>
          <figure class="content-visual">
            <img src={withBase(card.image)} alt={card.alt} loading="lazy" decoding="async" />
          </figure>
          <div class="project-card-content">
            <span class="card-index">0{index + 1}</span>
            <h2>{card.title}</h2>
            <p>{card.description}</p>
            <div class="project-meta"><span>{card.label}</span><b>→</b></div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
