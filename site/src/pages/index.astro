---
import BaseLayout from "../layouts/BaseLayout.astro";
import { catalogue, prestations } from "../lib/catalogue";
import { withBase } from "../lib/paths";

const identity = catalogue.identite as Record<string, string>;
const navigationCards = [
  {
    title: "Parcours & CV",
    phrase: "Relier l’agronomie, la recherche et les données.",
    label: "Explorer le parcours",
    href: "/experiences/",
    tone: "home-navigation-card--deep"
  },
  {
    title: "Réalisations",
    phrase: "Des méthodes, des outils et des résultats documentés.",
    label: "Voir les réalisations",
    href: "/projets/",
    tone: "home-navigation-card--sage"
  },
  {
    title: "Conseil & prestations indépendantes",
    phrase: "Faire de vos données un levier de décision.",
    label: "Découvrir les prestations",
    href: "/prestations/",
    tone: "home-navigation-card--cream"
  }
];
---

<BaseLayout description={identity.presentation}>
  <section class="hero shell">
    <div class="eyebrow">{prestations.positionnement}</div>
    <div class="hero-grid">
      <div>
        <h1>Moïse<br /><em>Placier</em></h1>
        <p class="hero-title">{prestations.titre_accueil}</p>
        <p class="hero-availability">{prestations.disponibilite}</p>
      </div>
      <aside class="hero-portrait-card">
        <figure class="hero-portrait">
          <img src={withBase("/visuals/portrait-moise.jpg")} alt="Portrait de Moïse Placier" />
        </figure>
      </aside>
    </div>
  </section>

  <section class="shell section services-preview">
    <div class="section-heading">
      <div>
        <span class="eyebrow">{prestations.page.surtitre}</span>
        <h2>{prestations.page.titre}</h2>
      </div>
    </div>
  </section>

  <section class="shell section home-navigation">
    <div class="home-navigation-grid">
      {navigationCards.map((card, index) => (
        <a class:list={["home-navigation-card", card.tone]} href={withBase(card.href)}>
          <span class="card-index">0{index + 1} · {card.title}</span>
          <h2>{card.phrase}</h2>
          <span class="home-navigation-link">{card.label} <b>→</b></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
