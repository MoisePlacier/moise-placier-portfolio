---
import BaseLayout from "../layouts/BaseLayout.astro";
import { experiences, projets, catalogue, prestations } from "../lib/catalogue";
import { withBase } from "../lib/paths";

const identity = catalogue.identite as Record<string, string>;
---

<BaseLayout description={identity.presentation}>
  <section class="hero shell">
    <div class="eyebrow">{prestations.positionnement}</div>
    <div class="hero-grid">
      <div>
        <h1>Moïse<br /><em>Placier</em></h1>
        <p class="hero-title">{prestations.titre_accueil}</p>
        <p class="hero-lead">{prestations.accroche}</p>
        <p class="hero-availability">{prestations.disponibilite}</p>
        <div class="hero-actions">
          <a class="button button-dark" href={withBase("/prestations/#contact")}>{prestations.appel_action.libelle} <span>→</span></a>
          <a class="text-link" href={withBase("/experiences/")}>Explorer le parcours <span>→</span></a>
        </div>
      </div>
      <aside class="identity-card audience-card">
        <figure class="hero-portrait">
          <img src={withBase("/visuals/portrait-moise.jpg")} alt="Portrait de Moïse Placier" />
        </figure>
        <span class="kicker">Deux chemins</span>
        <p>Un même socle technique, pour rejoindre une équipe ou mener une mission ciblée.</p>
        <div class="audience-links">
          {prestations.publics.map((publicCible) => (
            <a href={withBase(publicCible.lien)}>
              <strong>{publicCible.titre}</strong>
              <span>{publicCible.description}</span>
              <small>{publicCible.libelle_lien} <b>→</b></small>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="shell section services-preview">
    <div class="section-heading">
      <div>
        <span class="eyebrow">{prestations.page.surtitre}</span>
        <h2>{prestations.page.titre}</h2>
      </div>
      <a class="text-link" href={withBase("/prestations/")}>Voir les prestations <span>→</span></a>
    </div>
    <div class="service-strip">
      {prestations.page.expertises.map((expertise, index) => (
        <article>
          <span>0{index + 1}</span>
          <h3>{expertise.titre}</h3>
          <p>{expertise.resume}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section statement-grid">
    <div>
      <span class="eyebrow">Méthode</span>
      <h2>Faire dialoguer contraintes de production, méthode et analyse.</h2>
    </div>
    <div class="statement-copy">
      <p>Chaque expérience est présentée par ses réalisations concrètes, les compétences mobilisées et, lorsque leur diffusion est autorisée, les pièces qui les attestent.</p>
      <div class="numbers">
        <div><strong>{experiences.length}</strong><span>expériences</span></div>
        <div><strong>{projets.length}</strong><span>projets académiques</span></div>
        <div><strong>{Object.keys(catalogue.sources).filter((id) => catalogue.sources[id].visibilite === "public").length}</strong><span>justificatifs publics</span></div>
      </div>
    </div>
  </section>

  <section class="shell section projects-callout">
    <span class="eyebrow">Projets</span>
    <h2>Modélisation, machine learning et données du vivant.</h2>
    <p>Trois projets académiques sur les protéines, les cultures et la génomique végétale.</p>
    <a class="button button-light" href={withBase("/projets/")}>Voir les projets <span>→</span></a>
  </section>
</BaseLayout>
